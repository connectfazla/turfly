# Copy to .env.local (Next.js's own convention — not .env) and fill in.

# --- Database -----------------------------------------------------------
# Neon: use the DIRECT connection string, NOT the "-pooler" one. The pooled
# endpoint's PgBouncer transaction-mode pooling breaks Prisma's interactive
# $transaction() API, which every booking write uses — see CLAUDE.md §10.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Site identity --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Root domain for venue subdomains ({slug}.$NEXT_PUBLIC_ROOT_DOMAIN). Locally
# this is unused unless you're testing subdomains via *.lvh.me — see README.
NEXT_PUBLIC_ROOT_DOMAIN=turfly.xyz

# --- Email (Loops.so, transactional) --------------------------------------
# Without an API key and template ids, auth emails (verify/reset/invite) are
# logged to the server console instead of sent — fine for local dev.
LOOPS_API_KEY=
LOOPS_TXN_EMAIL_VERIFY=
LOOPS_TXN_PASSWORD_RESET=
LOOPS_TXN_INVITE=
LOOPS_TXN_DUPLICATE_SIGNUP=

# --- Venue branding (Vercel Blob) ------------------------------------------
# Without this, logo uploads (app/admin/branding) refuse clearly instead of
# throwing — nothing else in the app depends on it. Provision by creating a
# Blob store in the Vercel dashboard and linking it to this project, which
# fills this in for you on Vercel; only needed locally to test uploads.
BLOB_READ_WRITE_TOKEN=

# --- Booking notifications (Resend) ----------------------------------------
RESEND_API_KEY=
SMS_API_KEY=
# 'false' disables notifications entirely (NoopNotifier) — the safe default
# for local dev, since there's no real customer to email.
NOTIFICATIONS_ENABLED=false

TZ=Asia/Dhaka
