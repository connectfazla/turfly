// Turfly — data model
// See CLAUDE.md §2 and §5, and the multi-tenant SaaS architecture addendum
// (CLAUDE.md §11) for the Tenant/Venue/VenueStaff model below. The partial
// unique index on Booking is NOT expressible in Prisma schema syntax — it
// must be added by hand in a migration. Read the note at the bottom of this
// file before running migrate.
//
// MULTI-TENANT PHASE 0 (this pass): Tenant/Venue/VenueStaff/PlatformAdmin
// are new. Booking/SlotRule/Blackout/Payment/AuditLog gain a NULLABLE
// venueId (Booking/AuditLog also gain a nullable tenantId) — nullable
// deliberately, because the partial unique index and every application
// query stay untouched in this pass (see the note at the bottom of this
// file). Every existing row is backfilled to "Venue Zero" by
// scripts/backfill-tenant-zero.ts. VenueSetting is retired: its fields
// move onto Venue (a per-venue settings row is just Venue itself — a
// separate singleton-settings model doesn't fit multi-venue). Making
// venueId NOT NULL and widening the partial index to include it is
// deferred to a later pass, once lib/booking-engine.ts's queries are
// actually venue-aware (not just column-populated) — see this file's
// bottom note.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  ADMIN
  MODERATOR
}

/// Per-venue staff role — deliberately does NOT include an OWNER value.
/// Ownership is derived from Clerk Organization membership (org:admin role
/// on the venue's tenant), not a VenueStaff row — see CLAUDE.md §11. Only
/// staff a Turf Owner explicitly invites get a VenueStaff row.
enum VenueStaffRole {
  MANAGER
  BOOKIE
}

enum BookingStatus {
  HELD
  /// Customer has submitted a bKash advance TRXN and is waiting for staff
  /// to verify it landed. Occupies the slot exclusively, same as HELD/
  /// CONFIRMED/COMPLETED — see the partial index note at the bottom of
  /// this file. Auto-expires to EXPIRED after PAYMENT_VERIFICATION_HOURS
  /// if staff never act on it (lib/booking-engine.ts's sweep).
  PENDING_VERIFICATION
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum BookingSource {
  ONLINE
  COUNTER
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK_TRANSFER
  CARD
  OTHER
}

/// VERIFIED is the default because every Payment row staff create directly
/// (RecordPaymentForm, recordPayment()) was money they physically took —
/// there is nothing to verify. PENDING exists only for the one path where
/// the money hasn't been confirmed by a human yet: a customer's
/// self-reported bKash advance TRXN, submitted at booking time and sitting
/// in the admin "awaiting verification" queue until staff check it against
/// their bKash statement.
enum PaymentClaimStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ---------------------------------------------------------------- staff

/// One row per human staff member — the FK anchor every mutation points at
/// (Booking.createdById, Blackout.createdById, Payment.receivedById,
/// AuditLog.actorId). Customers are NEVER Users — they do not authenticate
/// as staff.
///
/// Authentication itself lives in Clerk; this row is the local identity
/// that Clerk account binds to, via clerkUserId. Keeping it (rather than
/// storing bare Clerk ids on every FK) is what lets an audit entry or an
/// old booking still render "who did this" after the Clerk account is
/// deleted — see the Clerk-cutover plan's Decision 1.
model User {
  id String @id @default(cuid())

  /// The bound Clerk account. Null means "invited but has never signed in
  /// yet" (VenueStaff grant exists, the person hasn't accepted) or, for
  /// the legacy pre-Clerk rows, "not yet rebound to a real Clerk user".
  clerkUserId String? @unique
  email       String  @unique
  name        String

  /// SECURITY: the ONLY address allowed to bind a Clerk account to this
  /// row on first sign-in, and only when Clerk reports that address
  /// verified. Deliberately separate from `email` (which an owner can
  /// edit for display) so editing a display address can never widen who
  /// is allowed to claim the row. See lib/auth/require-role.ts's
  /// resolveStaffUser().
  invitedEmail String?

  /// LEGACY (Auth.js credentials login). Nullable as of the Clerk cutover
  /// — new rows never get one — and dropped entirely in a later migration
  /// once no code reads it.
  passwordHash String?
  /// LEGACY (ADMIN | MODERATOR). Superseded by the derived OWNER /
  /// MANAGER / BOOKIE model: ownership comes from Tenant.ownerClerkUserId
  /// and staff roles from VenueStaff. Dropped in a later migration.
  role Role @default(MODERATOR)

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookingsCreated Booking[]    @relation("BookingCreatedBy")
  paymentsTaken   Payment[]    @relation("PaymentReceivedBy")
  blackouts       Blackout[]
  auditEntries    AuditLog[]
  venueGrants     VenueStaff[]

  @@index([role, isActive])
  @@index([invitedEmail])
}

// ---------------------------------------------------------------- tenancy

/// One Clerk Organization = one Tenant = one Turf Owner's business account.
/// clerkOrgId is nullable ONLY for "Tenant Zero" (see the bottom-of-file
/// backfill note) — every tenant created through the real owner-onboarding
/// flow always has one. plan/status are unused today (no billing yet) —
/// present so a future billing layer doesn't need a schema migration to
/// add them, per the SaaS architecture plan's explicit non-goal.
model Tenant {
  id               String   @id @default(cuid())
  clerkOrgId       String?  @unique
  name             String
  ownerClerkUserId String?
  ownerEmail       String?
  plan             String   @default("free")
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  venues Venue[]

  @@index([clerkOrgId])
}

/// A single physical turf. One Tenant can own several (multi-venue
/// support). Everything that was the single global VenueSetting row is
/// now a field here instead — see the bottom-of-file note for why
/// VenueSetting itself is gone.
model Venue {
  id                       String   @id @default(cuid())
  tenantId                 String
  tenant                   Tenant   @relation(fields: [tenantId], references: [id])
  /// Public booking URL component: /v/[slug]/book. Owner-editable but
  /// must stay URL-safe — validated at the Zod layer, not here.
  slug                     String   @unique
  /// Short code folded into the booking reference: TRF-{code}-YYYY-NNNN
  /// (see the bottom-of-file note — the reference format itself doesn't
  /// change until the venue-scoping pass that also touches
  /// lib/booking-engine.ts).
  code                     String   @unique
  name                     String
  contactPhone             String
  contactEmail             String?
  rulesText                String
  holdMinutes              Int      @default(10)
  cancellationWindowHours  Int      @default(6)
  bookingWindowDays        Int      @default(14)
  bkashNumber              String   @default("01700000000")
  /// Replaces VenueSetting.advanceAmount's fixed BDT figure — the deposit
  /// customers must pay is now a percentage of each booking's price.
  /// Booking.depositAmount (a later pass) snapshots the computed BDT
  /// figure at hold time, same reasoning as Booking.priceAmount already
  /// snapshotting SlotRule.price.
  depositPercent           Int      @default(30)
  paymentVerificationHours Int      @default(24)
  /// Field only, for now — every date/slot calculation stays hardcoded to
  /// Asia/Dhaka regardless of this value (SaaS architecture plan's
  /// explicit non-goal: no multi-region support yet).
  timezone                 String   @default("Asia/Dhaka")
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  slotRules SlotRule[]
  blackouts Blackout[]
  bookings  Booking[]
  payments  Payment[]
  staff     VenueStaff[]

  @@index([tenantId])
}

/// A grant: this staff member has this role at THIS one venue. Owners are
/// never rows here (see VenueStaffRole's doc comment) — this table exists
/// purely because Clerk Organization roles are org-wide, not scoped to one
/// venue within a multi-venue tenant, so per-venue Manager/Bookie access
/// has to be tracked ourselves.
///
/// Points at User.id, NOT at a bare Clerk id: User is the single "one row
/// per human" record every other FK in the schema already references, so
/// keying grants the same way is what lets a grant and a booking that
/// person created resolve to the same identity. A grant can exist before
/// the person has ever signed in (User.clerkUserId still null) — that is
/// exactly the pending-invitation state.
model VenueStaff {
  id       String @id @default(cuid())
  venueId  String
  venue    Venue  @relation(fields: [venueId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  /// Denormalized from venue.tenantId — lets a tenant-wide staff listing
  /// query without joining through every venue.
  tenantId String

  role     VenueStaffRole
  isActive Boolean        @default(true)

  invitedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([venueId, userId])
  @@index([tenantId])
  @@index([userId])
}

/// Platform-level super admin — deliberately just a membership list, no
/// permissions model, since there's a population of one today. A DB
/// table rather than an env var so it can be granted/revoked without a
/// redeploy (same "DB value, not baked into source" reasoning as
/// Venue.bkashNumber).
model PlatformAdmin {
  clerkUserId String   @id
  name        String?
  email       String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------- public

/// Identified by mobile number. No password, no login.
model Customer {
  id            String   @id @default(cuid())
  phone         String   @unique
  fullName      String
  /// Column stays nullable so old rows never need a backfill, but every
  /// NEW booking (public confirm form, counter form) requires it at the
  /// Zod layer — see lib/schemas/booking.ts's confirmBookingSchema.
  email         String?
  /// Same nullability story as email above.
  address       String?
  teamName      String?
  /// Optional Clerk account link — Customer stays global (not venue- or
  /// tenant-scoped), deliberately, because the "my bookings" view the
  /// SaaS product wants must span every venue a customer has booked at,
  /// not just one. Nullable: booking with just a phone number, no
  /// account, keeps working exactly as before.
  clerkUserId   String?  @unique
  totalBookings Int      @default(0)
  totalNoShows  Int      @default(0)
  isBlocked     Boolean  @default(false)
  blockedReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[]

  @@index([fullName])
  @@index([isBlocked])
}

// ---------------------------------------------------------------- core

model Booking {
  id        String @id @default(cuid())
  reference String @unique // TRF-2026-0184

  /// Nullable in THIS pass only — see the bottom-of-file note.
  /// scripts/backfill-tenant-zero.ts sets it on every existing row; every
  /// row created from here on also gets it (lib/booking-engine.ts still
  /// writes without it for now, since the engine itself isn't venue-aware
  /// yet — the backfill script fixes those rows up immediately after).
  venueId  String?
  venue    Venue?  @relation(fields: [venueId], references: [id])
  /// Denormalized from venue.tenantId — lets Super Admin cross-tenant
  /// reports query Booking without joining through Venue.
  tenantId String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// Calendar day only, no time component. NEVER compare directly with new Date().
  date      DateTime @db.Date
  /// 0..15. Slot n starts at n * 90 minutes after midnight. 4 = maintenance.
  slotIndex Int

  status                       BookingStatus @default(HELD)
  /// Set only while status = HELD. Swept inside createBooking's transaction.
  holdExpiresAt                DateTime?
  /// Set only while status = PENDING_VERIFICATION — the failsafe deadline
  /// for staff to verify the submitted bKash TRXN before the slot is
  /// automatically released back to the pool. Same shape as holdExpiresAt,
  /// swept by the same mechanism (lib/booking-engine.ts).
  paymentVerificationExpiresAt DateTime?

  priceAmount   Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)

  source      BookingSource @default(ONLINE)
  createdById String?
  createdBy   User?         @relation("BookingCreatedBy", fields: [createdById], references: [id])

  checkedInAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  customerNote String?
  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  // NOTE: this @@unique is a PLACEHOLDER so Prisma knows the shape.
  // It must be REPLACED by the partial index in the migration — see bottom of file.
  // MULTI-TENANT: still keyed on (date, slotIndex) only, NOT (venueId, date,
  // slotIndex), in this pass — see the bottom-of-file note for why.
  @@unique([date, slotIndex], name: "one_live_booking_per_slot")
  @@index([date, status])
  @@index([customerId])
  @@index([status, holdExpiresAt])
  @@index([reference])
  @@index([venueId])
}

// ---------------------------------------------------------------- config

/// Seeded with 112 rows: 7 weekdays × 16 slots.
/// slotIndex 4 is seeded isBookable=false on EVERY day — this is how the
/// maintenance window is data rather than a hard-coded condition.
model SlotRule {
  id         String  @id @default(cuid())
  /// Nullable in this pass — see Booking.venueId's doc comment above.
  venueId    String?
  venue      Venue?  @relation(fields: [venueId], references: [id])
  dayOfWeek  Int // 0 = Sunday … 6 = Saturday
  slotIndex  Int // 0..15
  isBookable Boolean @default(true)
  price      Decimal @db.Decimal(10, 2)

  // MULTI-TENANT: stays (dayOfWeek, slotIndex) in this pass, not
  // (venueId, dayOfWeek, slotIndex) — same reasoning as Booking's index.
  @@unique([dayOfWeek, slotIndex])
  @@index([dayOfWeek])
  @@index([venueId])
}

/// A null slotIndex closes the entire day.
model Blackout {
  id          String   @id @default(cuid())
  /// Nullable in this pass — see Booking.venueId's doc comment above.
  venueId     String?
  venue       Venue?   @relation(fields: [venueId], references: [id])
  date        DateTime @db.Date
  slotIndex   Int?
  reason      String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // MULTI-TENANT: stays (date, slotIndex) in this pass — same reasoning.
  @@unique([date, slotIndex])
  @@index([date])
  @@index([venueId])
}

// VenueSetting (the pre-multi-tenant global settings singleton) is RETIRED
// as of the multi-tenant conversion — its fields all live on Venue now
// (see the Venue model above and this file's bottom note). It was read
// one last time by scripts/backfill-tenant-zero.ts to create "Venue
// Zero" before this migration dropped its table.

// ---------------------------------------------------------------- money

/// A booking may have several rows so advances and balances are both traceable.
model Payment {
  id           String        @id @default(cuid())
  bookingId    String
  booking      Booking       @relation(fields: [bookingId], references: [id])
  /// Denormalized from booking.venueId — the revenue-report read path
  /// filters heavily by venue+date and this avoids a join. Nullable in
  /// this pass, same as Booking.venueId.
  venueId      String?
  venue        Venue?        @relation(fields: [venueId], references: [id])
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(CASH)
  /// Null only while status = PENDING — a customer's self-reported claim
  /// has no staff receiver until someone verifies it. Every VERIFIED or
  /// REJECTED row has this set to whoever made that call.
  receivedById String?
  receivedBy   User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime      @default(now())
  note         String?

  /// Defaults to VERIFIED: staff-recorded rows (RecordPaymentForm) are
  /// money already physically taken, nothing left to verify. Only the
  /// customer-submitted bKash-advance path creates a PENDING row.
  status         PaymentClaimStatus @default(VERIFIED)
  /// The customer-entered bKash transaction ID, for the PENDING advance
  /// path only. Never validated against bKash's own systems — this app
  /// has no bKash merchant API integration, so verification is manual
  /// (staff check their bKash statement) per CLAUDE.md's "no secrets, no
  /// third-party payment gateway" scope.
  trxId          String?
  rejectedReason String?

  @@index([bookingId])
  @@index([receivedAt])
  @@index([status])
  @@index([venueId])
}

// ---------------------------------------------------------------- audit

/// Append-only. Written by the domain layer, never updated or deleted.
/// References any entity by type + id — deliberately no foreign key, so an
/// audit row survives deletion of the thing it describes.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // BOOKING_CREATED, BOOKING_CANCELLED, PRICE_UPDATED, …
  entityType String // Booking | Customer | SlotRule | Blackout | User | Venue | Tenant
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  /// Both nullable — some actions (venue creation, staff invite) are
  /// tenant-level, not tied to one venue; entries written before this
  /// pass have neither.
  venueId    String?
  tenantId   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([venueId])
  @@index([tenantId])
}

// ---------------------------------------------------------------- rate limiting

/// Backs lib/auth/rate-limit.ts. Deliberately NOT an in-memory Map: Vercel
/// serverless functions are not guaranteed to reuse the same instance
/// between requests, so an in-memory bucket would silently stop limiting
/// anything under real production traffic — this table is the shared
/// store every instance reads/writes, keyed by e.g. "login:1.2.3.4" or
/// "hold:1.2.3.4". Rows are opportunistically pruned once stale rather
/// than on a cron (same pattern as sweepExpiredHolds) — see rate-limit.ts.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ================================================================
// REQUIRED MANUAL MIGRATION STEP
// ================================================================
//
// The @@unique([date, slotIndex]) above is WRONG on its own: it would also
// block re-booking a slot after a cancellation, because cancelled rows stay
// in the table.
//
// After running `prisma migrate dev --create-only`, edit the generated SQL:
//
//   -- remove the plain unique index Prisma generated
//   DROP INDEX IF EXISTS "Booking_date_slotIndex_key";
//
//   -- replace it with a PARTIAL unique index over live bookings only
//   CREATE UNIQUE INDEX one_live_booking_per_slot
//   ON "Booking" (date, "slotIndex")
//   WHERE status IN ('HELD','CONFIRMED','COMPLETED');
//
// Then run `prisma migrate dev`. Verify with `\d "Booking"` in psql that the
// index exists AND shows its WHERE clause. This one index is what makes double
// booking structurally impossible.
//
// UPDATE (payment-verification feature): PENDING_VERIFICATION was added to
// BookingStatus so a slot stays exclusively reserved while staff verify a
// customer's submitted bKash TRXN. The index's WHERE clause was widened in
// a LATER migration to:
//
//   WHERE status IN ('HELD','CONFIRMED','COMPLETED','PENDING_VERIFICATION')
//
// This had to be its own migration, run AFTER the one that adds the new
// enum value — Postgres will not let a transaction both add an enum value
// and use that value (e.g. in an index predicate) in the same transaction,
// and `prisma migrate dev` runs each migration.sql as one transaction.
//
// UPDATE (multi-tenant SaaS conversion, Phase 0): Tenant/Venue/VenueStaff/
// PlatformAdmin were added, and Booking/SlotRule/Blackout/Payment/AuditLog
// each gained a NULLABLE venueId (Booking/AuditLog also gained a nullable
// tenantId). The partial index above is DELIBERATELY left keyed on
// (date, slotIndex) only in this pass, NOT (venueId, date, slotIndex) —
// widening it now would be premature: lib/booking-engine.ts's queries
// aren't venue-aware yet (that's a later pass), so a venue-scoped index
// would just be unused dead weight until the code that needs it exists.
// scripts/backfill-tenant-zero.ts populates venueId on every existing
// row (there is, as of this pass, only ever one venue — "Venue Zero" —
// so this is a no-op for query correctness either way).
//
// The NEXT migration (once lib/booking-engine.ts, lib/availability-service.ts,
// and lib/auth/rate-limit.ts are made properly venue-aware, per the SaaS
// architecture plan) must, in order:
//   1. Make venueId NOT NULL on Booking/SlotRule/Blackout/Payment.
//   2. DROP INDEX one_live_booking_per_slot; DROP the plain SlotRule/
//      Blackout unique constraints.
//   3. CREATE UNIQUE INDEX one_live_booking_per_slot
//      ON "Booking" ("venueId", date, "slotIndex")
//      WHERE status IN ('HELD','CONFIRMED','COMPLETED','PENDING_VERIFICATION');
//      and the equivalent (venueId, dayOfWeek, slotIndex) / (venueId, date,
//      slotIndex) unique constraints on SlotRule/Blackout.
// This again cannot be one transaction with anything that adds a new enum
// value, per the note above — but nothing in THIS pass adds one, so that
// constraint doesn't apply to Phase 0 itself, only to whatever migration
// eventually does both at once.
//
// VenueSetting itself is retired in a FOLLOW-UP migration within this same
// pass (not this one) — its one existing row is read by
// scripts/backfill-tenant-zero.ts to create "Venue Zero" BEFORE the table
// is dropped, then a second migration drops it. Two migrations, in that
// order, for the same "don't destroy data you haven't copied yet" reason
// as every other multi-step migration in this file — not the enum-in-
// transaction reason.
// ================================================================
